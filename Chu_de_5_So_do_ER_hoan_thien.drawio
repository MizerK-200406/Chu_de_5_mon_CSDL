        <mxCell id="cl_card_note" parent="1" value="&lt;b&gt;Ký hiệu lực lượng (Crow's Foot):&lt;/b&gt; &amp;nbsp; &lt;b&gt;||&lt;/b&gt; = Bắt buộc 1 (1) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;o|&lt;/b&gt; = Không hoặc 1 (0..1) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;o&amp;lt;&lt;/b&gt; = Không hoặc nhiều (0..N) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;Ràng buộc nổi bật:&lt;/b&gt; MucHuong ∈ [80, 100]; Tối đa 30 lịch hẹn/BS/ngày/ca; BHYTChiTra + BenhNhanTra = TongTien." style="text;html=1;strokeColor=none;fillColor=#EFF6FF;rounded=1;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E3A8A;" vertex="1">
