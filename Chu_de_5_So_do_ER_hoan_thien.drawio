        <mxCell id="t_legend_guide" parent="1" value="&lt;b&gt;Ký hiệu cột:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;font color='#15803D'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;: Khóa chính &amp;nbsp;|&amp;nbsp; &lt;font color='#7E22CE'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;: Khóa ngoại &amp;nbsp;|&amp;nbsp; &lt;font color='#B45309'&gt;&lt;b&gt;PK,FK&lt;/b&gt;&lt;/font&gt;: Khóa chính kết hợp&lt;br/&gt;&amp;bull; &lt;b&gt;NN&lt;/b&gt;: NOT NULL &amp;nbsp;|&amp;nbsp; &lt;b&gt;UQ&lt;/b&gt;: UNIQUE &amp;nbsp;|&amp;nbsp; &lt;b&gt;GEN&lt;/b&gt;: Cột tính toán tự động&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ký hiệu Crow's Foot:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;1 : 0..N&lt;/b&gt; — Một bản ghi cha liên kết 0 đến nhiều bản ghi con&lt;br/&gt;&amp;bull; &lt;b&gt;1 : 0..1&lt;/b&gt; — Quan hệ 1-1 tùy chọn (DonThuoc, HoaDon theo CaKham)&lt;br/&gt;&amp;bull; &lt;b&gt;0..1 : 0..1&lt;/b&gt; — CaKham có thể khám vãng lai (MaLH NULL)&lt;br/&gt;&amp;bull; &lt;b&gt;0..1 : 0..N&lt;/b&gt; — HoaDon có thể không dùng BHYT (SoThe NULL)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;" vertex="1">
          <mxGeometry x="420" y="1321" width="380" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t_legend_rules" parent="1" value="&lt;b&gt;Ràng buộc nghiệp vụ chính:&lt;/b&gt; MucHuong ∈ [80, 100]; Tối đa 30 lịch hẹn/BS/ngày/ca; SoLuongTon &amp;gt; SoLuong kê; BHYTChiTra + BenhNhanTra = TongTien." style="text;html=1;strokeColor=none;fillColor=#EFF6FF;rounded=1;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Segoe UI;fontSize=10.5;fontColor=#1E3A8A;" vertex="1">
